FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
EXPOSE 8000
# Shell form (not exec-form array) so ${PORT} actually expands -- Railway and
# similar platforms inject PORT at runtime; docker-compose does not set it, so
# this still defaults to 8000 there.
CMD uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}
