APP_NAME=AI Data Analysis Agent
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/analytics
QUERY_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=5000
# Required in any real deployment. Left empty, the app signs with a random
# per-process key: tokens die on restart and a second worker cannot verify them.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# "development" | "production". Set to "production" when deploying: it turns
# demo-only defaults (notably SQLite metadata storage) from silent data loss
# into a refusal to start. See docs/DEPLOYMENT.md.
ENVIRONMENT=development
